          "label": "Show home page hero",
          "description": "Toggle the hero/search band on the home page.",
          "value": true
        },
        {
          "identifier": "content_max_width",
          "type": "range",
          "label": "Content max width (px)",
          "description": "Maximum width of the main content column.",
          "value": 960,
          "min": 720,
          "max": 1280,
          "step": 20
        }
      ]
    },
    {
      "label": "Brand",
      "variables": [
        {
          "identifier": "logo",
          "type": "file",
          "label": "Logo",
          "description": "Your help center logo."
        },
        {
          "identifier": "favicon",
          "type": "file",
          "label": "Favicon",
          "description": "Icon shown in the browser tab."
        }
      ]
    }
  ]
