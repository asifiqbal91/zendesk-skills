<main id="main-content" class="container">
  {{breadcrumbs}}
  <h1>{{section.name}}</h1>
  {{#if section.description}}<p class="lede">{{section.description}}</p>{{/if}}
  {{subscribe}}
  {{#if section.articles}}
  <ul class="article-list">
    {{#each section.articles}}
    <li><a href="{{url}}">{{title}}</a></li>
    {{/each}}
  </ul>
  {{pagination 'section.articles'}}
  {{else}}
  <p>{{t 'no_articles'}}</p>
  {{/if}}
</main>
