<main id="main-content" class="container">
  {{breadcrumbs}}
  <h1>{{request.subject}}</h1>
  <p><span class="status status-{{request.status}}">{{request.status_name}}</span> #{{request.id}}</p>
  {{satisfaction}}

  <ul class="comment-list">
    {{#each comments}}
    <li id="{{anchor}}" class="comment">
      <strong>{{author.name}}</strong>
      <time>{{date created_at timeago=true}}</time>
      <div>{{body}}</div>
      {{#each attachments}}<a href="{{url}}" target="_blank">{{name}}</a>{{/each}}
    </li>
    {{/each}}
  </ul>
  {{pagination}}
  {{comment_callout}}

  {{#form 'comment' class='comment-form'}}
    {{#if help_center.request_ccs_enabled}}{{token_field 'ccs'}}{{/if}}
    {{wysiwyg 'body' rows='7'}}
    {{upload}}
    {{checkbox 'mark_as_solved'}} {{label 'mark_as_solved'}}
    {{input type='submit'}}
  {{/form}}
</main>
