<main id="main-content" class="container">
  {{search submit=false instant=true}}
  {{generative_answers}}
  <h1>{{#if results}}{{t 'results' query=query count=results_count}}{{else}}{{t 'search_results'}}{{/if}}</h1>
  {{#if results}}
  <ul class="search-results">
    {{#each results}}
    <li>
      <h2><a href="{{url}}">{{title}}</a></h2>
      <p>{{text}}</p>
    </li>
    {{/each}}
  </ul>
  {{pagination}}
  {{else}}
  <p>{{t 'no_results_unified_start_new_search'}}</p>
  {{/if}}
</main>
