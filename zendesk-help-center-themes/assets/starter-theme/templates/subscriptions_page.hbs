<main id="main-content" class="container">
  <h1>{{t 'following'}}</h1>
  {{#if subscriptions}}
  <ul>
    {{#each subscriptions}}
    <li><a href="{{url}}">{{title}}</a> <small>{{name}}</small> {{subscribe}}</li>
    {{/each}}
  </ul>
  {{pagination}}
  {{else}}
  <p>{{t 'not_following'}}</p>
  {{/if}}
</main>
